  "apps": {
    "grove":       { "name": "The Grove",   "appId": "com.growwithgrounded.grove",      "scheme": "grounded-grove",      "start": "/grove/",       "tools": ["grove"],       "icon": "icons/grove-1024.png", "files": ["grove/"] },
    "maple":       { "name": "Maple",       "appId": "com.growwithgrounded.maple",      "scheme": "grounded-maple",      "start": "/maple/",       "tools": ["maple"],       "icon": "icons/maple-1024.png", "files": ["maple/", "grove/data.js", "grove/library.js"] },
    "aspen":       { "name": "Aspen",       "appId": "com.growwithgrounded.aspen",      "scheme": "grounded-aspen",      "start": "/aspen/",       "tools": ["aspen"],       "icon": "icons/aspen-1024.png", "files": ["aspen/", "grove/data.js", "grove/library.js"] },
    "pine":        { "name": "Pine",        "appId": "com.growwithgrounded.pine",       "scheme": "grounded-pine",       "start": "/pine/",        "tools": ["pine"],        "icon": "icons/pine-1024.png",  "files": ["pine/", "grove/data.js", "grove/library.js"] },
    "oak":         { "name": "Oak",         "appId": "com.growwithgrounded.oak",        "scheme": "grounded-oak",        "start": "/oak/",         "tools": ["oak"],         "icon": "icons/oak-1024.png",   "files": ["oak/", "grove/data.js", "grove/library.js"] },
    "sequoia":     { "name": "Sequoia",     "appId": "com.growwithgrounded.sequoia",    "scheme": "grounded-sequoia",    "start": "/sequoia/",     "tools": ["sequoia"],     "icon": "icons/sequoia-1024.png", "files": ["sequoia/", "grove/data.js", "grove/library.js"] },
    "willow":      { "name": "Willow",      "appId": "com.growwithgrounded.willow",     "scheme": "grounded-willow",     "start": "/willow/",      "tools": ["willow"],      "icon": "icons/willow-1024.png", "files": ["willow/"] },
    "field-guide": { "name": "Field Guide", "appId": "com.growwithgrounded.fieldguide", "scheme": "grounded-fieldguide", "start": "/field-guide/", "tools": ["field-guide"], "files": ["field-guide/", "grove/data.js", "grove/library.js", "maple/checkin.js", "maple/guides.js", "aspen/checkin.js", "aspen/guides.js", "oak/checkin.js", "oak/guides.js", "sequoia/checkin.js", "sequoia/guides.js", "pine/checkin.js", "pine/guides.js"] }
