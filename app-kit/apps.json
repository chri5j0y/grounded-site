{
  "_note": "One shared code base, five apps. Each app bundles only the files it needs, so it works fully offline.",
  "common": ["shared/", "fonts/", "nav.js", "read.js", "privacy.html", "terms.html", "style.css", "site.js", "favicon.svg", "apple-touch-icon.png"],
  "apps": {
    "grove":       { "name": "The Grove",    "appId": "com.growwithgrounded.grove",      "scheme": "grounded-grove",      "start": "/grove/",       "tools": ["grove"],       "files": ["grove/"] },
    "sprout":      { "name": "Sprout",       "appId": "com.growwithgrounded.sprout",     "scheme": "grounded-sprout",     "start": "/sprout/",      "tools": ["sprout"],      "files": ["sprout/"] },
    "sapling":     { "name": "Sapling",      "appId": "com.growwithgrounded.sapling",    "scheme": "grounded-sapling",    "start": "/sapling/",     "tools": ["sapling"],     "files": ["sapling/"] },
    "soul-tree":   { "name": "Soul Tree",    "appId": "com.growwithgrounded.soultree",   "scheme": "grounded-soultree",   "start": "/soul-tree/",   "tools": ["soul-tree"],   "files": ["soul-tree/"] },
    "field-guide": { "name": "Field Guide",  "appId": "com.growwithgrounded.fieldguide", "scheme": "grounded-fieldguide", "start": "/field-guide/", "tools": ["field-guide"], "files": ["field-guide/", "grove/data.js", "grove/library.js", "sprout/checkup.js", "sprout/guides.js", "sapling/checkup.js", "sapling/guides.js", "soul-tree/guides.js"] }
  },
  "plugins": ["@capacitor/preferences", "@capacitor/filesystem", "@capacitor/share", "@capacitor/browser", "@capacitor/app", "@capacitor/app-launcher", "@capacitor/local-notifications"]
}
